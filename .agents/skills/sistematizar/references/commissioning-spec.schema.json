{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.local/schemas/commissioning-spec.schema.json",
  "title": "INEVITA System Commissioning Spec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "system_id",
    "name",
    "version",
    "evidence",
    "result",
    "trigger",
    "capability",
    "entities",
    "sources",
    "pipeline",
    "routines",
    "permissions",
    "eval",
    "learning",
    "frontier",
    "baseline"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "system_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "refs"],
      "properties": {
        "state": { "const": "observed" },
        "refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "path", "purpose"],
            "properties": {
              "role": { "$ref": "#/$defs/id" },
              "path": { "type": "string", "minLength": 1 },
              "purpose": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["statement", "non_success", "output_type", "definition_of_done", "owner", "human_gate"],
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "non_success": { "type": "string", "minLength": 1 },
        "output_type": { "$ref": "#/$defs/id" },
        "definition_of_done": { "type": "string", "minLength": 1 },
        "owner": { "type": "string", "minLength": 1 },
        "human_gate": { "type": "string", "minLength": 1 }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "description"],
      "properties": {
        "type": { "enum": ["manual", "event", "schedule"] },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "name", "task", "when_to_use", "when_not_to_use"],
      "properties": {
        "capability_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "task": { "type": "string", "minLength": 1 },
        "when_to_use": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "when_not_to_use": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "entities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "role", "required"],
        "properties": {
          "type": { "$ref": "#/$defs/id" },
          "role": { "$ref": "#/$defs/id" },
          "required": { "type": "boolean" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "source_id", "required", "access", "freshness", "purpose", "truth_home"],
        "properties": {
          "role": { "$ref": "#/$defs/id" },
          "source_id": { "type": ["string", "null"] },
          "required": { "type": "boolean" },
          "access": { "enum": ["manual", "read-only", "write-with-approval"] },
          "freshness": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "truth_home": { "type": "string", "minLength": 1 }
        }
      }
    },
    "pipeline": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["state", "input", "output", "gate"],
        "properties": {
          "state": { "$ref": "#/$defs/id" },
          "input": { "type": "string", "minLength": 1 },
          "output": { "type": "string", "minLength": 1 },
          "gate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "routines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["trigger", "owner", "input", "output", "gate"],
        "properties": {
          "trigger": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "input": { "type": "string", "minLength": 1 },
          "output": { "type": "string", "minLength": 1 },
          "gate": { "type": "string", "minLength": 1 }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "external_actions"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" } },
        "write": { "type": "array", "items": { "type": "string" } },
        "external_actions": { "const": false }
      }
    },
    "eval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "deterministic_gates", "human_questions", "outcome_measure"],
      "properties": {
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "deterministic_gates": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "human_questions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "outcome_measure": { "$ref": "#/$defs/id" }
      }
    },
    "learning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correction_policy", "promotion_threshold", "requires_replay", "requires_human_approval"],
      "properties": {
        "correction_policy": { "const": "candidate-first" },
        "promotion_threshold": { "type": "integer", "minimum": 3 },
        "requires_replay": { "const": true },
        "requires_human_approval": { "const": true }
      }
    },
    "frontier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["local", "derived", "forbidden"],
      "properties": {
        "local": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "derived": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "forbidden": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measure", "value", "period", "source"],
      "properties": {
        "measure": { "$ref": "#/$defs/id" },
        "value": { "type": ["string", "number", "boolean"] },
        "period": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
  }
}
