{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/learning-candidate-v1.json",
  "title": "INEVITA Learning Candidate V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "candidate_id", "learning_type", "system_ref", "routine_id",
    "source_correction_ref", "evidence_run_ref", "approval_judgment_ref", "status",
    "occurrences", "promotion_threshold", "replay_status", "created_by", "created_at",
    "privacy"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "candidate_id": { "$ref": "#/$defs/ref" },
    "learning_type": { "const": "correction-candidate" },
    "system_ref": { "$ref": "#/$defs/id" },
    "routine_id": { "$ref": "#/$defs/id" },
    "source_correction_ref": { "$ref": "#/$defs/local_ref" },
    "evidence_run_ref": { "$ref": "#/$defs/local_ref" },
    "approval_judgment_ref": { "$ref": "#/$defs/local_ref" },
    "status": { "const": "candidate" },
    "occurrences": { "const": 1 },
    "promotion_threshold": { "type": "integer", "minimum": 3 },
    "replay_status": { "const": "not-eligible" },
    "created_by": { "$ref": "#/$defs/ref" },
    "created_at": { "type": "string", "format": "date-time" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_shared_with_inevita", "correction_recorded", "output_recorded",
        "motor_changed", "external_action_executed"
      ],
      "properties": {
        "content_shared_with_inevita": { "const": false },
        "correction_recorded": { "const": false },
        "output_recorded": { "const": false },
        "motor_changed": { "const": false },
        "external_action_executed": { "const": false }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "local_ref": { "type": "string", "pattern": "^(?!\\.?\\.?$)(?!\\.?\\.?/)(?!.*\\/\\.\\.(?:\\/|$))[A-Za-z0-9.][A-Za-z0-9_./:-]{0,255}$" }
  }
}
