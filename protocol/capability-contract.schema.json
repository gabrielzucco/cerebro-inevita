{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/capability-contract-v1.json",
  "title": "INEVITA Capability Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "capability_id",
    "name",
    "version",
    "task",
    "input_roles",
    "output",
    "permissions",
    "human_authority",
    "evals"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "capability_id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "version": { "$ref": "#/$defs/version" },
    "task": { "type": "string", "minLength": 1, "maxLength": 500 },
    "when_to_use": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "when_not_to_use": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "input_roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "required", "purpose"],
        "properties": {
          "role": { "$ref": "#/$defs/id" },
          "required": { "type": "boolean" },
          "purpose": { "type": "string", "minLength": 1 }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "definition_of_done"],
      "properties": {
        "type": { "$ref": "#/$defs/id" },
        "definition_of_done": { "type": "string", "minLength": 1 }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read", "write", "external_actions"],
      "properties": {
        "read": { "type": "array", "items": { "type": "string" } },
        "write": { "type": "array", "items": { "type": "string" } },
        "external_actions": { "type": "boolean" }
      }
    },
    "human_authority": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "evals": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$" }
  }
}
