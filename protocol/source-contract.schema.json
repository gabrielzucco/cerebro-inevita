{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/source-contract-v1.json",
  "title": "INEVITA Source Contract V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "source_id",
    "name",
    "type",
    "status",
    "truth",
    "authority",
    "scope",
    "sensitivity",
    "pii",
    "modes",
    "freshness",
    "retention",
    "revocation",
    "connector",
    "authorized_consumers",
    "assurance"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "source_id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "type": { "$ref": "#/$defs/id" },
    "status": { "enum": ["mapped", "active", "degraded", "revoked"] },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["home_ref", "source_of_truth"],
      "properties": {
        "home_ref": { "type": "string", "minLength": 1 },
        "source_of_truth": { "type": "boolean" }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner_ref", "status"],
      "properties": {
        "owner_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
        "status": { "enum": ["confirmed", "unconfirmed"] }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "entity_types", "boundaries"],
      "properties": {
        "purpose": { "type": "string", "minLength": 1 },
        "entity_types": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "boundaries": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "sensitivity": { "enum": ["private", "team", "public"] },
    "pii": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "handling"],
      "properties": {
        "classification": { "enum": ["unknown", "none", "possible", "contains"] },
        "handling": { "enum": ["reference-only", "local-processing", "not-applicable"] }
      }
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["read", "propose", "write-with-approval", "external-action"] }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "observed_at"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "observed_at": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "until"],
      "properties": {
        "policy": { "type": "string", "minLength": 1 },
        "until": { "type": ["string", "null"], "format": "date-time" }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "effect", "revocable"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "effect": { "enum": ["future-only", "receipt-only", "irreversible-export"] },
        "revocable": { "type": "boolean" }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "binding_ref", "credential_ref", "custody"],
      "properties": {
        "kind": { "$ref": "#/$defs/id" },
        "binding_ref": { "type": ["string", "null"], "minLength": 1 },
        "credential_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,255}$" },
        "custody": { "enum": ["runtime-exclusive", "agent-direct", "none"] }
      }
    },
    "authorized_consumers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_type", "subject_ref"],
        "properties": {
          "subject_type": { "enum": ["system", "agent", "role", "person"] },
          "subject_ref": { "$ref": "#/$defs/ref" }
        }
      }
    },
    "assurance": { "enum": ["runtime-enforced", "receipt-audited", "exported"] },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" }
  }
}
