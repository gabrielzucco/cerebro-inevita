{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/access-grant-v1.json",
  "title": "INEVITA Access Grant V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version",
    "grant_id",
    "subject",
    "scope",
    "mode",
    "assurance",
    "custody",
    "reason",
    "issued_at",
    "expires_at",
    "revoked_at",
    "approved_by",
    "credential_ref",
    "receipts"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "grant_id": { "$ref": "#/$defs/ref" },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["type", "ref"],
      "properties": {
        "type": { "enum": ["system", "agent", "role", "person"] },
        "ref": { "$ref": "#/$defs/ref" }
      }
    },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["company_ref", "unit_ref", "system_refs", "source_refs", "actions"],
      "properties": {
        "company_ref": { "$ref": "#/$defs/ref" },
        "unit_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
        "system_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } },
        "source_refs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/ref" } },
        "actions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/id" } }
      }
    },
    "mode": { "enum": ["read", "propose", "write-with-approval", "external-action"] },
    "assurance": { "enum": ["runtime-enforced", "receipt-audited", "exported"] },
    "custody": { "enum": ["runtime-exclusive", "agent-direct", "exported-copy"] },
    "reason": { "type": "string", "minLength": 1 },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "revoked_at": { "type": ["string", "null"], "format": "date-time" },
    "approved_by": { "$ref": "#/$defs/ref" },
    "credential_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,255}$" },
    "receipts": {
      "type": "object", "additionalProperties": false, "required": ["use_refs", "revocation_ref"],
      "properties": {
        "use_refs": { "type": "array", "items": { "$ref": "#/$defs/local_ref" } },
        "revocation_ref": { "type": ["string", "null"], "minLength": 1 }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "local_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,255}$" }
  }
}
