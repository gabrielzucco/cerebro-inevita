{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/experience-manifest-v1.json",
  "title": "INEVITA Experience Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "experience_id", "system_ref", "publisher", "presentation", "surfaces"],
  "properties": {
    "protocol_version": { "const": 1 },
    "experience_id": { "$ref": "#/$defs/id" },
    "system_ref": { "$ref": "#/$defs/id" },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["publisher_id", "display_name", "kind"],
      "properties": {
        "publisher_id": { "$ref": "#/$defs/id" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["organization", "person"] }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tagline", "mark"],
      "properties": {
        "tagline": { "type": "string", "minLength": 1, "maxLength": 120 },
        "mark": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text", "accent"],
          "properties": {
            "kind": { "const": "monogram" },
            "text": { "type": "string", "pattern": "^[A-Za-z0-9&+]{1,3}$" },
            "accent": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" }
          }
        }
      }
    },
    "surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface_id", "role", "kind", "launch_label"],
        "properties": {
          "surface_id": { "$ref": "#/$defs/id" },
          "role": { "$ref": "#/$defs/id" },
          "kind": { "const": "external-application" },
          "launch_label": { "type": "string", "minLength": 1, "maxLength": 40 }
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" }
  }
}
