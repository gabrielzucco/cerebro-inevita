{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/execution-trace-event-v1.json",
  "title": "INEVITA Execution Trace Event V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "trace_id", "event_id", "run_id", "sequence", "step_id",
    "step_type", "state", "occurred_at", "parent_step_id", "system_ref", "routine_ref",
    "source_ref", "capability_ref", "skill_ref", "input_refs", "output_refs",
    "reason_code", "evidence_ref", "privacy"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "trace_id": { "$ref": "#/$defs/ref" },
    "event_id": { "$ref": "#/$defs/ref" },
    "run_id": { "$ref": "#/$defs/ref" },
    "sequence": { "type": "integer", "minimum": 1 },
    "step_id": { "$ref": "#/$defs/id" },
    "step_type": {
      "enum": ["run", "access", "collector", "retrieval", "skill", "model", "connector", "capability", "output", "eval", "judgment"]
    },
    "state": {
      "enum": ["declared", "running", "completed", "failed", "denied", "skipped", "gap", "pending"]
    },
    "occurred_at": { "type": "string", "format": "date-time" },
    "parent_step_id": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "system_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "routine_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,255}$" },
    "source_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "capability_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,255}$" },
    "skill_ref": { "type": ["string", "null"], "pattern": "^(?!.*\\.\\.(?:/|$))[A-Za-z0-9.][A-Za-z0-9_./:-]{0,255}$" },
    "model_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,255}$" },
    "connector_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,255}$" },
    "assurance": {
      "enum": ["requested-not-verified", "provider-reported", "verified", "exported", "receipt-audited", "runtime-enforced", null]
    },
    "chain_id": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" },
    "mode": { "enum": ["replay", "live", null] },
    "experiment_ref": { "type": ["string", "null"], "pattern": "^EXP-[A-Za-z0-9_-]{1,48}$" },
    "handoff_refs": { "type": "array", "items": { "$ref": "#/$defs/local_ref" }, "uniqueItems": true },
    "input_refs": { "type": "array", "items": { "$ref": "#/$defs/local_ref" } },
    "output_refs": { "type": "array", "items": { "$ref": "#/$defs/local_ref" } },
    "reason_code": { "type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "evidence_ref": { "type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9_./:-]{0,255}$" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_shared_with_inevita", "payload_recorded", "raw_error_recorded"],
      "properties": {
        "content_shared_with_inevita": { "const": false },
        "payload_recorded": { "const": false },
        "raw_error_recorded": { "const": false }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{7,127}$" },
    "local_ref": { "type": "string", "pattern": "^(?!.*\\.\\.(?:/|$))[A-Za-z0-9.][A-Za-z0-9_./:-]{0,255}$" }
  }
}
