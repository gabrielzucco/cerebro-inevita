{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/collector-binding-v1.json",
  "title": "INEVITA Collector Binding V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "binding_id", "kind", "executable", "args", "workspace_ref",
    "workspace_path", "output_ref", "timeout_seconds", "status", "observed_at", "privacy"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "binding_id": { "$ref": "#/$defs/ref" },
    "kind": { "const": "trusted-local-command" },
    "executable": { "enum": ["python3", "node"] },
    "args": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": { "$ref": "#/$defs/arg" }
    },
    "workspace_ref": { "$ref": "#/$defs/ref" },
    "workspace_path": { "oneOf": [{ "const": "." }, { "$ref": "#/$defs/local_ref" }] },
    "output_ref": { "$ref": "#/$defs/local_ref" },
    "timeout_seconds": { "type": "integer", "minimum": 10, "maximum": 1800 },
    "status": { "enum": ["ready", "missing", "degraded"] },
    "observed_at": { "type": "string", "format": "date-time" },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_stored", "stdout_recorded", "content_shared_with_inevita"],
      "properties": {
        "credential_stored": { "const": false },
        "stdout_recorded": { "const": false },
        "content_shared_with_inevita": { "const": false }
      }
    }
  },
  "$defs": {
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "local_ref": { "type": "string", "pattern": "^(?!\\.?\\.?$)(?!\\.?\\.?/)(?!.*?/\\.\\.(?:/|$))[A-Za-z0-9.][A-Za-z0-9_./:-]{0,255}$" },
    "arg": { "type": "string", "pattern": "^(?!/)(?!-c$)(?!.*[;&|`$<>])[A-Za-z0-9._/:=-]{1,255}$" }
  }
}
