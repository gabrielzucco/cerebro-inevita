{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/journey-contract-v1.json",
  "title": "INEVITA Journey Contract V1",
  "description": "Jornada: o modelo da gravata-borboleta por pessoa, no catálogo. Estágios com dono (o dono do sistema do estágio), critérios de entrada e saída, medidas nos quatro tipos (volume, conversão, tempo, custo), campos SPICED colhidos, fontes dos pontos de contato, o nó da compra (handoff que abre o ciclo da direita) e o loop da direita (a expansão volta para a educação; o ciclo não termina). A instância por pessoa (member-id, estágio atual e desde quando, pontos de contato, SPICED, trabalhos, próxima ação, valor acumulado) vive na casa de registro declarada em `instance.store_ref`, nunca aqui; o vault só recebe o destilado. Reference-only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "journey_id", "version", "name", "status", "area_ref", "model", "subject", "stages",
    "node", "loop", "cycle_refs", "instance", "legacy", "privacy"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "journey_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["proposed", "confirmed", "active", "paused", "retired"] },
    "area_ref": { "$ref": "#/$defs/id" },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["shape", "reference_ref"],
      "properties": {
        "shape": { "enum": ["bowtie", "funnel", "loop"] },
        "reference_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/local_ref" }] }
      }
    },
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "id_field"],
      "properties": {
        "type": { "enum": ["person", "company"] },
        "id_field": { "enum": ["member-id", "current-stage", "stage-since", "touchpoints", "spiced", "works", "next-action", "accumulated-value"] }
      }
    },
    "stages": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/stage" } },
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["stage_ref", "handoff_artifact_ref", "opens_cycle_ref"],
      "properties": {
        "stage_ref": { "$ref": "#/$defs/id" },
        "handoff_artifact_ref": { "$ref": "#/$defs/id" },
        "opens_cycle_ref": { "$ref": "#/$defs/id" }
      }
    },
    "loop": {
      "type": "object", "additionalProperties": false,
      "required": ["from_stage_ref", "to_stage_ref", "artifact_ref", "identified_by_system_ref", "closed_by_system_ref", "recurring"],
      "properties": {
        "from_stage_ref": { "$ref": "#/$defs/id" },
        "to_stage_ref": { "$ref": "#/$defs/id" },
        "artifact_ref": { "$ref": "#/$defs/id" },
        "identified_by_system_ref": { "$ref": "#/$defs/id" },
        "closed_by_system_ref": { "$ref": "#/$defs/id" },
        "recurring": { "const": true }
      }
    },
    "cycle_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
    "instance": {
      "type": "object", "additionalProperties": false,
      "required": ["store_ref", "fields", "vault_policy"],
      "properties": {
        "store_ref": { "$ref": "#/$defs/id" },
        "fields": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["member-id", "current-stage", "stage-since", "touchpoints", "spiced", "works", "next-action", "accumulated-value"] }
        },
        "vault_policy": { "const": "distilled-only" }
      }
    },
    "legacy": {
      "type": "object", "additionalProperties": false,
      "required": ["notes"],
      "properties": {
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 400 } }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["content_in_catalog", "pii_in_catalog"],
      "properties": {
        "content_in_catalog": { "const": false },
        "pii_in_catalog": { "const": false }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$" },
    "local_ref": { "type": "string", "pattern": "^(?!\\.?\\.?$)(?!\\.?\\?/)(?!.*\\/\\.\\.(?:\\/|$))[A-Za-z0-9.][A-Za-z0-9_./:-]{0,255}$" },
    "measure": {
      "type": "object", "additionalProperties": false,
      "required": ["code", "statement", "source_ref", "decided"],
      "properties": {
        "code": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 16 }] },
        "statement": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 240 }] },
        "source_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ref" }] },
        "decided": { "type": "boolean" }
      }
    },
    "stage": {
      "type": "object", "additionalProperties": false,
      "required": [
        "stage_id", "name", "side", "order", "system_ref", "owner_ref", "entry_criterion", "exit_criterion",
        "measures", "spiced_fields", "touchpoint_source_refs", "workflow_refs", "next_stage_refs"
      ],
      "properties": {
        "stage_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "side": { "enum": ["left", "node", "right"] },
        "order": { "type": "integer", "minimum": 1 },
        "system_ref": { "$ref": "#/$defs/id" },
        "owner_ref": { "$ref": "#/$defs/ref" },
        "entry_criterion": { "type": "string", "minLength": 1, "maxLength": 400 },
        "exit_criterion": { "type": "string", "minLength": 1, "maxLength": 400 },
        "measures": {
          "type": "object", "additionalProperties": false,
          "required": ["volume", "conversion", "time", "cost"],
          "properties": {
            "volume": { "$ref": "#/$defs/measure" },
            "conversion": { "$ref": "#/$defs/measure" },
            "time": { "$ref": "#/$defs/measure" },
            "cost": { "$ref": "#/$defs/measure" }
          }
        },
        "spiced_fields": { "type": "array", "uniqueItems": true, "items": { "enum": ["situation", "pain", "impact", "critical-event", "decision"] } },
        "touchpoint_source_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "workflow_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "next_stage_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } }
      }
    }
  }
}
