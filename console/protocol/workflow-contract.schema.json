{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/workflow-contract-v1.json",
  "title": "INEVITA Workflow Contract V1",
  "description": "Workflow: receita de um gatilho (relógio, evento ou pessoa) a um resultado, com passos. Cada passo declara executor, pacote, verbos permitidos, critério de submissão e idempotência. `scope: area` com `kind: cycle` é um ciclo: atravessa sistemas por handoff e mede por raia; `kind: cycle-variant` é a receita concreta de um ciclo. `cycle.journey_ref` (opcional) liga o ciclo à jornada da pessoa que ele percorre. `alias: rotina` é o apelido do workflow de relógio. Reference-only: o contrato não carrega prompt, saída nem conteúdo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol_version", "workflow_id", "version", "name", "status", "scope", "kind", "alias",
    "area_ref", "system_ref", "cycle", "trigger", "responsible_ref", "result", "steps", "handoffs",
    "legacy", "privacy"
  ],
  "properties": {
    "protocol_version": { "const": 1 },
    "workflow_id": { "$ref": "#/$defs/id" },
    "version": { "$ref": "#/$defs/version" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "status": { "enum": ["proposed", "confirmed", "active", "needs_attention", "paused", "retired"] },
    "scope": { "enum": ["system", "area"] },
    "kind": { "enum": ["workflow", "child", "cycle", "cycle-variant"] },
    "alias": { "oneOf": [{ "type": "null" }, { "const": "rotina" }] },
    "area_ref": { "$ref": "#/$defs/id" },
    "system_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
    "cycle": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["cycle_ref", "variant", "lanes"],
          "properties": {
            "cycle_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
            "variant": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
            "lanes": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/lane" } },
            "journey_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }
          }
        }
      ]
    },
    "trigger": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "schedule", "event", "person"],
      "properties": {
        "type": { "enum": ["schedule", "event", "person"] },
        "schedule": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/schedule" }] },
        "event": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/event" }] },
        "person": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/person" }] }
      }
    },
    "responsible_ref": { "$ref": "#/$defs/ref" },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["statement", "measure"],
      "properties": {
        "statement": { "type": "string", "minLength": 1, "maxLength": 400 },
        "measure": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 240 }] }
      }
    },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } },
    "handoffs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/handoff" } },
    "legacy": {
      "type": "object", "additionalProperties": false,
      "required": ["routine_refs", "system_refs", "skill_refs", "workflow_definition_ref", "placement", "notes"],
      "properties": {
        "routine_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "system_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "skill_refs": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/local_ref" } },
        "workflow_definition_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/local_ref" }] },
        "placement": { "enum": ["host-gabriel-local", "vps", "github-actions", "railway", "manual", "none"] },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 400 } }
      }
    },
    "privacy": {
      "type": "object", "additionalProperties": false,
      "required": ["content_in_catalog"],
      "properties": { "content_in_catalog": { "const": false } }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][A-Za-z0-9.-]+)?$" },
    "local_ref": { "type": "string", "pattern": "^(?!\\.?\\.?$)(?!\\.?\\?/)(?!.*\\/\\.\\.(?:\\/|$))[A-Za-z0-9.][A-Za-z0-9_./:-]{0,255}$" },
    "time": { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" },
    "lane": {
      "type": "object", "additionalProperties": false,
      "required": ["system_ref", "measure"],
      "properties": {
        "system_ref": { "$ref": "#/$defs/id" },
        "measure": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "schedule": {
      "type": "object", "additionalProperties": false,
      "required": ["cadence", "time", "timezone", "weekdays", "month_days", "detail"],
      "properties": {
        "cadence": { "enum": ["interval", "hourly", "daily", "weekdays", "weekly", "monthly"] },
        "time": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/time" }] },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 80 },
        "weekdays": { "type": "array", "uniqueItems": true, "items": { "enum": ["MO", "TU", "WE", "TH", "FR", "SA", "SU"] } },
        "month_days": { "type": "array", "uniqueItems": true, "items": { "type": "integer" } },
        "detail": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 240 }] }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["source_ref", "events"],
      "properties": {
        "source_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ref" }] },
        "events": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 120 } }
      }
    },
    "person": {
      "type": "object", "additionalProperties": false,
      "required": ["requester_ref", "description"],
      "properties": {
        "requester_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/ref" }] },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 }
      }
    },
    "executor": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "ref"],
      "properties": {
        "kind": { "enum": ["person", "agent", "script", "service"] },
        "ref": { "$ref": "#/$defs/ref" }
      }
    },
    "step": {
      "type": "object", "additionalProperties": false,
      "required": [
        "step_id", "name", "system_ref", "executor", "package_ref", "verbs", "submission_criterion",
        "idempotency", "requires", "handoff_ref", "child_workflow_ref", "optional"
      ],
      "properties": {
        "step_id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "system_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "executor": { "$ref": "#/$defs/executor" },
        "package_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "verbs": {
          "type": "array", "uniqueItems": true,
          "items": { "enum": ["read", "search", "cite", "propose", "write-with-approval", "external-action", "publish"] }
        },
        "submission_criterion": { "type": "string", "minLength": 1, "maxLength": 400 },
        "idempotency": {
          "type": "object", "additionalProperties": false,
          "required": ["scope", "key"],
          "properties": {
            "scope": { "enum": ["work", "slot", "artifact", "none"] },
            "key": { "type": "string", "minLength": 1, "maxLength": 160 }
          }
        },
        "requires": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "handoff_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "child_workflow_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "optional": { "type": "boolean" }
      }
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["handoff_id", "from_system_ref", "to_system_ref", "artifact_type", "schema_ref", "opens_workflow_ref"],
      "properties": {
        "handoff_id": { "$ref": "#/$defs/id" },
        "from_system_ref": { "$ref": "#/$defs/id" },
        "to_system_ref": { "$ref": "#/$defs/id" },
        "artifact_type": { "$ref": "#/$defs/id" },
        "schema_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/local_ref" }] },
        "opens_workflow_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }
      }
    }
  }
}
