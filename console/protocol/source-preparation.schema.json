{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/schemas/source-preparation-v1.json",
  "title": "INEVITA Source Preparation V1",
  "description": "Entrada de fonte no catálogo da empresa: camadas em que a fonte existe (bruto, tratado, destilado, átomo, consolidado, índice), cadência de captura, sensibilidade e quem prepara. O bloco `preparation` é o mesmo que um Source Contract V1 carrega em `extensions.preparation`; o contrato completo (truth, authority, connector, consumers) continua no Source Contract. Reference-only.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "source_id", "name", "preparation", "legacy"],
  "properties": {
    "protocol_version": { "const": 1 },
    "source_id": { "$ref": "#/$defs/id" },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "preparation": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "layers", "cadence", "sensitivity", "owner_area_ref", "owner_system_ref", "preparer_workflow_ref"],
      "properties": {
        "schema_version": { "const": 1 },
        "layers": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "enum": ["raw", "organized", "distilled", "atoms", "consolidated", "index"] }
        },
        "cadence": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "time", "timezone", "detail"],
          "properties": {
            "kind": { "enum": ["continuous", "interval", "hourly", "daily", "weekly", "monthly", "on-event", "manual", "unspecified"] },
            "time": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$" }] },
            "timezone": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 80 }] },
            "detail": { "oneOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 240 }] }
          }
        },
        "sensitivity": { "enum": ["private", "team", "public"] },
        "owner_area_ref": { "$ref": "#/$defs/id" },
        "owner_system_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] },
        "preparer_workflow_ref": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/id" }] }
      }
    },
    "legacy": {
      "type": "object", "additionalProperties": false,
      "required": ["source_contract_ref", "notes"],
      "properties": {
        "source_contract_ref": { "$ref": "#/$defs/local_ref" },
        "notes": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 400 } }
      }
    },
    "extensions": { "type": "object" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "local_ref": { "type": "string", "pattern": "^(?!\\.?\\.?$)(?!\\.?\\?/)(?!.*\\/\\.\\.(?:\\/|$))[A-Za-z0-9.][A-Za-z0-9_./:-]{0,255}$" }
  }
}
