            "role": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
            },
            "policy": {
              "$ref": "#/$defs/policy-ref"
            }
          }
        },
        "permission_policy": {
          "$ref": "#/$defs/policy-ref"
        },
        "residence_policy": {
          "$ref": "#/$defs/policy-ref"
        },
        "retention_policy": {
          "$ref": "#/$defs/policy-ref"
        },
