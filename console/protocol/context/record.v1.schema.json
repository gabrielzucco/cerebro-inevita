      "properties": {
        "namespace": {
          "const": "brain-context"
        },
        "schema_version": {
          "const": 1
        },
        "kind": {
          "const": "source"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "family": {
          "enum": [
            "platform",
            "meetings",
            "calls",
            "groups",
            "commercial",
            "media",
            "decisions"
          ]
        },
        "purpose": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
