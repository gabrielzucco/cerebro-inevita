        "mode": {
          "enum": [
            "continuous",
            "event",
            "on_demand",
            "not_required"
          ]
        },
        "max_lag_seconds": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 31536000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
