          "properties": {
            "item_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
            },
            "revision_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
            },
            "cursor": {
              "enum": [
                "opaque",
                "timestamp",
                "none"
              ]
            },
            "partition_key": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
            }
          }
        },
        "changes": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "created",
            "edited",
            "removed",
            "reconciliation",
            "late_items",
            "limitations"
          ],
          "properties": {
            "created": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
