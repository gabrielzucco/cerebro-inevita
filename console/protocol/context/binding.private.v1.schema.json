{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:company-brain:context-binding:private:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "namespace",
    "schema_version",
    "source",
    "instance_ref",
    "environment_ref",
    "home_ref",
    "binding_ref",
    "credential_ref",
    "connector_kind",
    "custody",
    "owner",
    "access",
    "permission",
    "runtime_ref"
  ],
  "properties": {
    "namespace": {
      "const": "brain-context-private"
    },
    "schema_version": {
      "const": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "const": "source"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        }
      }
    },
    "instance_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
    },
    "environment_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
    },
    "home_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "binding_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    },
    "credential_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "connector_kind": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
    },
    "custody": {
      "enum": [
        "runtime-exclusive",
        "agent-direct",
        "none"
      ]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "const": "actor"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        }
      }
    },
    "access": {
      "enum": [
        "allowed",
        "denied",
        "revoked"
      ]
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id",
        "version"
      ],
      "properties": {
        "kind": {
          "const": "policy"
        },
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
        }
      }
    },
    "runtime_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,255}$"
    }
  }
}
