{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "attempts",
    "access_receipt_refs"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "mode": {
      "enum": [
        "observe",
        "enforce"
      ]
    },
    "attempts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "attempt",
          "boundary",
          "coverage",
          "unmediated_reads_possible",
          "payload_digest",
          "bytes",
          "inputs",
          "sources"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "minimum": 1
          },
          "boundary": {
            "const": "executor-dispatch"
          },
          "coverage": {
            "enum": [
              "mediated",
              "partial"
            ]
          },
          "unmediated_reads_possible": {
            "type": "boolean"
          },
          "payload_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "ref_digest",
                "digest",
                "bytes"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "instructions",
                    "supplemental",
                    "decision"
                  ]
                },
                "ref_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "source_ref",
                "layer",
                "partition",
                "version",
                "selection_digest",
                "content_digest",
                "bytes",
                "grant_ref",
                "access_receipt_ref"
              ],
              "properties": {
                "source_ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "layer": {
                  "enum": [
                    "raw",
                    "organized",
                    "distilled",
                    "period_summary",
                    "atoms",
                    "projection",
                    "profile",
                    "index",
                    null
                  ]
                },
                "partition": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "version": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "selection_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "content_digest": {
                  "type": "string",
                  "pattern": "^sha256:[a-f0-9]{64}$"
                },
                "bytes": {
                  "type": "integer",
                  "minimum": 0
                },
                "grant_ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                },
                "access_receipt_ref": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                }
              }
            }
          }
        }
      }
    },
    "access_receipt_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
      }
    }
  }
}
