{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.ai/protocol/artifacts/funnel-reading.schema.json",
  "title": "Funnel Reading Artifact V1",
  "description": "Leitura do funil produzida por um Sistema de medição — fato, inferência e proposta separados, com proveniência por claim. É o artefato que fecha uma chain de experimento: a medição referencia o briefing consumido e o experimento lido.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact_type", "schema_version", "reading_id", "produced_by", "experiment_ref",
    "window", "facts", "inferences", "proposal", "gaps"
  ],
  "properties": {
    "artifact_type": { "const": "funnel-reading" },
    "schema_version": { "type": "string", "pattern": "^1\\.\\d+\\.\\d+$" },
    "reading_id": { "$ref": "#/$defs/opaque_ref" },
    "produced_by": {
      "type": "object", "additionalProperties": false,
      "required": ["system_ref", "run_ref"],
      "properties": {
        "system_ref": { "$ref": "#/$defs/id" },
        "run_ref": { "$ref": "#/$defs/opaque_ref" }
      }
    },
    "experiment_ref": {
      "oneOf": [
        { "type": "string", "pattern": "^EXP-[A-Za-z0-9_-]{1,48}$" },
        { "type": "null" }
      ]
    },
    "window": { "type": "string", "minLength": 1, "maxLength": 500 },
    "facts": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "evidence_refs"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "evidence_refs": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["claim", "based_on"],
        "properties": {
          "claim": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "based_on": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 512 }
          }
        }
      }
    },
    "proposal": { "type": ["string", "null"], "maxLength": 4000 },
    "gaps": {
      "type": "array",
      "items": { "type": "string", "minLength": 1, "maxLength": 1000 }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
    "opaque_ref": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$" }
  }
}
