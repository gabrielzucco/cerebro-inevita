{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inevita.local/protocol/operational-knowledge-candidate.schema.json",
  "title": "Operational knowledge candidate",
  "description": "Contrato sanitizado entre uma Fonte operacional e o gate humano que pode publicar aprendizado no Segundo Cérebro.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "idempotency_key",
    "system_ref",
    "learning_type",
    "title",
    "body",
    "theme",
    "vault_source",
    "privacy_attestation",
    "provenance_kind",
    "source_refs",
    "evidence_ref"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "idempotency_key": { "$ref": "#/$defs/opaqueRef" },
    "system_ref": { "$ref": "#/$defs/opaqueRef" },
    "learning_type": {
      "enum": [
        "decision",
        "funnel_learning",
        "copy_learning",
        "operation_improvement",
        "system_improvement"
      ]
    },
    "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\r\\n]+$" },
    "body": { "type": "string", "minLength": 1, "maxLength": 32000 },
    "theme": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{1,79}$" },
    "vault_source": {
      "enum": ["call", "mente-propria", "producao-conteudo", "operacao-comunidade", "grupo-comunidade"]
    },
    "privacy_attestation": { "const": "sanitized_no_pii" },
    "provenance_kind": {
      "enum": ["human_verbatim", "human_decision", "human_source_distillation"]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/opaqueRef" }
    },
    "evidence_ref": { "$ref": "#/$defs/opaqueRef" }
  },
  "$defs": {
    "opaqueRef": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]+$"
    }
  }
}
